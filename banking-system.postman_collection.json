    {
      "name": "6 — Complete E2E Test Flow",
      "description": "Run these in order to test the entire system end-to-end.\nEach request auto-sets variables via test scripts.\n\nFlow:\n1. Create User 1 + User 2\n2. Open accounts for each\n3. Deposit into Account 1\n4. Debit Account 1 (generates notification)\n5. Transfer from Account 1 to Account 2 (generates 2 notifications)\n6. Check notifications for both users",
      "item": [

        {
          "name": "E2E-01: Create User 1",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/users", "host": ["{{base_url}}"], "path": ["v1","users"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Wonderland\",\n  \"email\": \"alice@banking.test\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 201', function() { pm.response.to.have.status(201); });",
                "var body = pm.response.json();",
                "pm.test('User is ACTIVE', function() { pm.expect(body.status).to.equal('ACTIVE'); });",
                "pm.collectionVariables.set('user_id', body.id);"
              ],
              "type": "text/javascript"
            }
          }],
          "response": []
        },

        {
          "name": "E2E-02: Create User 2",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/users", "host": ["{{base_url}}"], "path": ["v1","users"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Bob\",\n  \"lastName\": \"Builder\",\n  \"email\": \"bob@banking.test\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 201', function() { pm.response.to.have.status(201); });",
                "var body = pm.response.json();",
                "pm.collectionVariables.set('user_id_2', body.id);"
              ],
              "type": "text/javascript"
            }
          }],
          "response": []
        },

        {
          "name": "E2E-03: Open SAVINGS Account for User 1",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/accounts", "host": ["{{base_url}}"], "path": ["v1","accounts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{user_id}},\n  \"type\": \"SAVINGS\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 201', function() { pm.response.to.have.status(201); });",
                "var body = pm.response.json();",
                "pm.test('Balance starts at 0', function() { pm.expect(parseFloat(body.balance)).to.equal(0); });",
                "pm.collectionVariables.set('account_id', body.id);"
              ],
              "type": "text/javascript"
            }
          }],
          "response": []
        },

        {
          "name": "E2E-04: Open CURRENT Account for User 2",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/accounts", "host": ["{{base_url}}"], "path": ["v1","accounts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{user_id_2}},\n  \"type\": \"CURRENT\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 201', function() { pm.response.to.have.status(201); });",
                "var body = pm.response.json();",
                "pm.collectionVariables.set('account_id_2', body.id);"
              ],
              "type": "text/javascript"
            }
          }],
          "response": []
        },

        {
          "name": "E2E-05: Deposit ₹10000 into Account 1",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/accounts/{{account_id}}/deposit", "host": ["{{base_url}}"], "path": ["v1","accounts","{{account_id}}","deposit"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10000.00\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', function() { pm.response.to.have.status(200); });",
                "var body = pm.response.json();",
                "pm.test('Balance is 10000', function() { pm.expect(parseFloat(body.balance)).to.equal(10000); });"
              ],
              "type": "text/javascript"
            }
          }],
          "response": []
        },

        {
          "name": "E2E-06: Debit ₹1500 from Account 1",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/transactions/debit", "host": ["{{base_url}}"], "path": ["v1","transactions","debit"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": {{account_id}},\n  \"amount\": 1500.00,\n  \"description\": \"E2E debit test\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 201', function() { pm.response.to.have.status(201); });",
                "var body = pm.response.json();",
                "pm.test('Transaction COMPLETED', function() { pm.expect(body.status).to.equal('COMPLETED'); });",
                "pm.test('Type is DEBIT', function() { pm.expect(body.type).to.equal('DEBIT'); });",
                "pm.collectionVariables.set('txn_id', body.id);"
              ],
              "type": "text/javascript"
            }
          }],
          "response": []
        },

        {
          "name": "E2E-07: Transfer ₹3000 from Account 1 → Account 2",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/transactions/transfer", "host": ["{{base_url}}"], "path": ["v1","transactions","transfer"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": {{account_id}},\n  \"targetAccountId\": {{account_id_2}},\n  \"amount\": 3000.00,\n  \"description\": \"E2E transfer test\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 201', function() { pm.response.to.have.status(201); });",
                "var body = pm.response.json();",
                "pm.test('Transaction COMPLETED', function() { pm.expect(body.status).to.equal('COMPLETED'); });",
                "pm.test('Type is TRANSFER', function() { pm.expect(body.type).to.equal('TRANSFER'); });"
              ],
              "type": "text/javascript"
            }
          }],
          "response": []
        },

        {
          "name": "E2E-08: Verify Account 1 Balance (should be ₹5500)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/accounts/{{account_id}}/balance", "host": ["{{base_url}}"], "path": ["v1","accounts","{{account_id}}","balance"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', function() { pm.response.to.have.status(200); });",
                "var body = pm.response.json();",
                "pm.test('Balance is 5500 (10000 - 1500 - 3000)', function() {",
                "  pm.expect(parseFloat(body.balance)).to.equal(5500);",
                "});"
              ],
              "type": "text/javascript"
            }
          }],
          "response": []
        },

        {
          "name": "E2E-09: Verify Account 2 Balance (should be ₹3000)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/accounts/{{account_id_2}}/balance", "host": ["{{base_url}}"], "path": ["v1","accounts","{{account_id_2}}","balance"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', function() { pm.response.to.have.status(200); });",
                "var body = pm.response.json();",
                "pm.test('Balance is 3000', function() {",
                "  pm.expect(parseFloat(body.balance)).to.equal(3000);",
                "});"
              ],
              "type": "text/javascript"
            }
          }],
          "response": []
        },

        {
          "name": "E2E-10: Check Notifications for User 1",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/notifications/user/{{user_id}}?unreadOnly=true",
              "host": ["{{base_url}}"],
              "path": ["v1","notifications","user","{{user_id}}"],
              "query": [{ "key": "unreadOnly", "value": "true" }]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', function() { pm.response.to.have.status(200); });",
                "var body = pm.response.json();",
                "pm.test('Has notifications (debit + transfer sent)', function() {",
                "  pm.expect(body.totalElements).to.be.at.least(2);",
                "});",
                "if (body.content && body.content.length > 0) {",
                "  pm.collectionVariables.set('notif_id', body.content[0].id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "response": []
        },

        {
          "name": "E2E-11: Check Notifications for User 2",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/notifications/user/{{user_id_2}}?unreadOnly=true",
              "host": ["{{base_url}}"],
              "path": ["v1","notifications","user","{{user_id_2}}"],
              "query": [{ "key": "unreadOnly", "value": "true" }]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', function() { pm.response.to.have.status(200); });",
                "var body = pm.response.json();",
                "pm.test('Has notification (transfer received)', function() {",
                "  pm.expect(body.totalElements).to.be.at.least(1);",
                "});"
              ],
              "type": "text/javascript"
            }
          }],
          "response": []
        },

        {
          "name": "E2E-12: Mark All Notifications Read for User 1",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{base_url}}/v1/notifications/user/{{user_id}}/read-all", "host": ["{{base_url}}"], "path": ["v1","notifications","user","{{user_id}}","read-all"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 204', function() { pm.response.to.have.status(204); });"
              ],
              "type": "text/javascript"
            }
          }],
          "response": []
        }

      ]
    }

