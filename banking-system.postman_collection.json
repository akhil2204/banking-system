    {
      "name": "3 — Transaction Service",
      "description": "Debit, Credit, Transfer. All return 201. Check 'status' field in response — may be FAILED.",
      "item": [

        {
          "name": "Debit Account 1 (₹200 — ATM withdrawal)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/transactions/debit", "host": ["{{base_url}}"], "path": ["v1","transactions","debit"] },
