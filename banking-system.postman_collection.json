{
  "info": {
    "name": "Banking System — Complete API Collection",
    "description": "Full Postman collection for the Banking Microservices System.\n\nBase URL: http://localhost:8080 (API Gateway)\n\nFlow to test:\n1. Create a user\n2. Open accounts (two accounts for transfer testing)\n3. Deposit funds\n4. Run debit / credit / transfer\n5. Check notifications\n\nAll requests go through the API Gateway on port 8080 with /v1/ prefix.\nService discovery via Eureka, load-balanced with lb://.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",   "value": "http://localhost:8080", "type": "string" },
    { "key": "user_id",    "value": "1",                     "type": "string" },
    { "key": "user_id_2",  "value": "2",                     "type": "string" },
    { "key": "account_id", "value": "1",                     "type": "string" },
    { "key": "account_id_2","value": "2",                    "type": "string" },
    { "key": "txn_id",     "value": "1",                     "type": "string" },
    { "key": "notif_id",   "value": "1",                     "type": "string" }
  ],
  "item": [

    {
      "name": "1 — User Service",
      "description": "Manage users: create, read, update, status change, soft delete.",
      "item": [

        {
          "name": "Create User (John Doe)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/users", "host": ["{{base_url}}"], "path": ["v1","users"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@example.com\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  var body = pm.response.json();",
                "  pm.collectionVariables.set('user_id', body.id);",
                "  console.log('user_id set to', body.id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "response": []
        },

        {
          "name": "Create User 2 (Jane Smith)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/users", "host": ["{{base_url}}"], "path": ["v1","users"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Smith\",\n  \"email\": \"jane.smith@example.com\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  var body = pm.response.json();",
                "  pm.collectionVariables.set('user_id_2', body.id);",
                "  console.log('user_id_2 set to', body.id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "response": []
        },

        {
          "name": "List All Users (paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/users?page=0&size=20&sort=createdAt,desc",
              "host": ["{{base_url}}"],
              "path": ["v1","users"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "createdAt,desc" }
              ]
            }
          },
          "response": []
        },

        {
          "name": "List Users — Filter by Status ACTIVE",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/users?status=ACTIVE&page=0&size=20",
              "host": ["{{base_url}}"],
              "path": ["v1","users"],
              "query": [
                { "key": "status", "value": "ACTIVE" },
                { "key": "page",   "value": "0" },
                { "key": "size",   "value": "20" }
              ]
            }
          },
          "response": []
        },

        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["v1","users","{{user_id}}"] }
          },
          "response": []
        },

        {
          "name": "Get User by Email",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/users/email/john.doe@example.com", "host": ["{{base_url}}"], "path": ["v1","users","email","john.doe@example.com"] }
          },
          "response": []
        },

        {
          "name": "Update User Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["v1","users","{{user_id}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jonathan\",\n  \"lastName\": \"Doe\",\n  \"email\": \"jonathan.doe@example.com\"\n}"
            }
          },
          "response": []
        },

        {
          "name": "Update User Status → SUSPENDED",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/users/{{user_id}}/status", "host": ["{{base_url}}"], "path": ["v1","users","{{user_id}}","status"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SUSPENDED\"\n}"
            }
          },
          "response": []
        },

        {
          "name": "Update User Status → ACTIVE",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/users/{{user_id}}/status", "host": ["{{base_url}}"], "path": ["v1","users","{{user_id}}","status"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}"
            }
          },
          "response": []
        },

        {
          "name": "Soft Delete User → 204",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/v1/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["v1","users","{{user_id}}"] }
          },
          "response": []
        },

        {
          "name": "[Error] Create User — Duplicate Email → 409",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/users", "host": ["{{base_url}}"], "path": ["v1","users"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Another\",\n  \"lastName\": \"Person\",\n  \"email\": \"john.doe@example.com\"\n}"
            }
          },
          "response": []
        },

        {
          "name": "[Error] Create User — Blank Name → 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/users", "host": ["{{base_url}}"], "path": ["v1","users"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"\",\n  \"lastName\": \"Doe\",\n  \"email\": \"valid@example.com\"\n}"
            }
          },
          "response": []
        },

        {
          "name": "[Error] Get User — Not Found → 404",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/users/99999", "host": ["{{base_url}}"], "path": ["v1","users","99999"] }
          },
          "response": []
        }

      ]
    },

